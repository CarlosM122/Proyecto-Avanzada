    background 0.15s,
    color 0.15s,
    border-color 0.15s;

  flex-shrink: 0;
}

.btn-logout:hover {
  background: var(--red-dim);
  border-color: rgba(248, 113, 113, 0.3);
  color: var(--red);
}

/* ══════════════════════════════
   MAIN
══════════════════════════════ */
.main-content {
  flex: 1;

  display: flex;
  flex-direction: column;

  overflow: hidden;
}

/* ─────────────────────────────
   TOPBAR
───────────────────────────── */
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;

  gap: 12px;

  padding: 24px 32px 0;

  flex-shrink: 0;
}

.topbar-left {
  display: flex;
  align-items: center;
  gap: 16px;
}

.btn-back {
  display: flex;
  align-items: center;
  gap: 6px;

  padding: 7px 12px;

  background: transparent;
  border: 1px solid var(--border);
  border-radius: 8px;

  color: var(--text-2);

  font-family: 'DM Sans', sans-serif;
  font-size: 13px;

  cursor: pointer;

  transition: all 0.15s;
}

.btn-back:hover {
  border-color: var(--border-hover);
  color: var(--text-1);
}

.breadcrumb {
  display: flex;
  align-items: center;
  gap: 8px;

  font-size: 13px;
}

.breadcrumb-parent {
  color: var(--text-3);
  cursor: pointer;
  transition: color 0.15s;
}

.breadcrumb-parent:hover {
  color: var(--text-2);
}

.breadcrumb-sep {
  color: var(--text-3);
}

.breadcrumb-current {
  color: var(--text-1);
  font-weight: 500;
}

/* ─────────────────────────────
   CONTENT
───────────────────────────── */
.detalle-content {
  flex: 1;

  overflow-y: auto;

  padding: 24px 32px 40px;

  display: flex;
  flex-direction: column;
  gap: 24px;

  scrollbar-width: thin;
  scrollbar-color: var(--border) transparent;
}

/* ─────────────────────────────
   HEADER SOLICITUD
───────────────────────────── */
.solicitud-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;

  gap: 16px;
}

.solicitud-header-left {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.solicitud-id {
  font-family: 'Syne', sans-serif;
  font-size: 13px;
  font-weight: 700;
  color: var(--text-3);
  letter-spacing: 1px;
}

.solicitud-tipo {
  font-family: 'Syne', sans-serif;
  font-size: 22px;
  font-weight: 700;
  color: var(--text-1);
}

.solicitud-header-right {
  display: flex;
  align-items: center;
  gap: 8px;

  flex-shrink: 0;
}

/* ─────────────────────────────
   BADGES
───────────────────────────── */
.badge-estado,
.badge-prioridad {
  display: inline-block;

  padding: 5px 12px;
  border-radius: 8px;

  font-size: 12px;
}

.badge-estado {
  font-weight: 500;
}

.badge-prioridad {
  font-weight: 600;
}

.estado-REGISTRADA {
  background: var(--blue-dim);
  border: 1px solid rgba(129, 140, 248, 0.2);
  color: var(--blue);
}

.estado-CLASIFICADA {
  background: var(--amber-dim);
  border: 1px solid rgba(251, 191, 36, 0.2);
  color: var(--amber);
}

.estado-EN_ATENCION {
  background: rgba(251, 191, 36, 0.15);
  border: 1px solid rgba(251, 191, 36, 0.3);
  color: var(--amber);
}

.estado-ATENDIDA {
  background: var(--accent-dim);
  border: 1px solid rgba(110, 231, 183, 0.2);
  color: var(--accent);
}

.estado-CERRADA {
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid var(--border);
  color: var(--text-3);
}

.prio-ALTA {
  background: var(--red-dim);
  border: 1px solid rgba(248, 113, 113, 0.2);
  color: var(--red);
}

.prio-MEDIA {
  background: var(--amber-dim);
  border: 1px solid rgba(251, 191, 36, 0.2);
  color: var(--amber);
}

.prio-BAJA {
  background: var(--accent-dim);
  border: 1px solid rgba(110, 231, 183, 0.2);
  color: var(--accent);
}

/* ─────────────────────────────
   INFO GRID
───────────────────────────── */
.info-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
}

.info-card {
  background: var(--surface);

  border: 1px solid var(--border);
  border-radius: var(--radius);

  padding: 20px;

  display: flex;
  flex-direction: column;
  gap: 10px;

  transition: border-color 0.2s;
}

.info-card:hover {
  border-color: var(--border-hover);
}

.info-card-full {
  grid-column: 1 / -1;
}

.info-label {
  font-size: 11px;
  font-weight: 500;

  color: var(--text-3);

  text-transform: uppercase;
  letter-spacing: 0.8px;
}

.info-value {
  font-size: 14px;
  color: var(--text-1);
  line-height: 1.5;
}

.info-desc {
  font-size: 15px;
  color: var(--text-2);
  line-height: 1.6;
}

.info-sub {
  font-size: 12px;
  color: var(--text-3);
  margin-top: 2px;
}

.info-empty {
  font-size: 13px;
  color: var(--text-3);
  font-style: italic;
}

/* ─────────────────────────────
   USER DISPLAY
───────────────────────────── */
.user-display {
  display: flex;
  align-items: center;
  gap: 12px;
}

.user-dot {
  width: 36px;
  height: 36px;

  background: var(--accent-dim);
  border: 1px solid rgba(110, 231, 183, 0.2);
  border-radius: 50%;

  display: flex;
  align-items: center;
  justify-content: center;

  font-family: 'Syne', sans-serif;
  font-weight: 700;
  font-size: 14px;

  color: var(--accent);

  flex-shrink: 0;
}

.user-dot-blue {
  background: var(--blue-dim);
  border-color: rgba(129, 140, 248, 0.2);
  color: var(--blue);
}

.historial-section {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.historial-titulo {
  font-family: 'Syne', sans-serif;
  font-size: 14px;
  font-weight: 700;
  color: var(--text-2);
  text-transform: uppercase;
  letter-spacing: 0.8px;
}

.historial-lista {
  display: flex;
  flex-direction: column;
  gap: 0;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  background: var(--surface);
  overflow: hidden;
}

.historial-item {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 14px 20px;
  border-bottom: 1px solid var(--border);
  transition: background 0.15s;
}

.historial-item:last-child {
  border-bottom: none;
}
.historial-item:hover {
  background: rgba(255, 255, 255, 0.02);
}

.historial-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--accent);
  flex-shrink: 0;
}

.historial-info {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.historial-accion {
  font-size: 13px;
  color: var(--text-1);
}

.historial-fecha {
  font-size: 11px;
  color: var(--text-3);
}

.ia-sugerencia {
  display: flex;
  align-items: center;
  gap: 10px;
}

.btn-ia {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 14px;
  background: var(--accent-dim);
  border: 1px solid rgba(110, 231, 183, 0.2);
  border-radius: 8px;
  color: var(--accent);
  font-family: 'Syne', sans-serif;
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.15s;
}

.btn-ia:hover:not(:disabled) {
  background: rgba(110, 231, 183, 0.18);
  border-color: rgba(110, 231, 183, 0.4);
}

.btn-ia:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.spinner-dark {
  border-color: rgba(110, 231, 183, 0.3);
  border-top-color: var(--accent);
}

/* ─────────────────────────────
   ACTION BUTTONS
───────────────────────────── */
.action-buttons {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}

.btn-action {
  padding: 10px 16px;
  border-radius: 10px;
  border: 1px solid transparent;

  font-family: 'DM Sans', sans-serif;
  font-size: 13px;
  font-weight: 600;

  cursor: pointer;
  transition: all 0.15s ease;

  color: white;
}

.btn-blue {
  background: var(--blue-dim);
  border-color: rgba(129, 140, 248, 0.25);
  color: var(--blue);
}

.btn-blue:hover {
  background: rgba(129, 140, 248, 0.18);
}

.btn-amber {
  background: var(--amber-dim);
  border-color: rgba(251, 191, 36, 0.25);
  color: var(--amber);
}

.btn-amber:hover {
  background: rgba(251, 191, 36, 0.18);
}

.btn-accent {
  background: var(--accent-dim);
  border-color: rgba(110, 231, 183, 0.25);
  color: var(--accent);
}

.btn-accent:hover {
  background: rgba(110, 231, 183, 0.18);
}

/* ─────────────────────────────
   MODAL
───────────────────────────── */
.modal-backdrop {
  position: fixed;
  inset: 0;

  background: rgba(0, 0, 0, 0.72);
  backdrop-filter: blur(4px);

  display: flex;
  align-items: center;
  justify-content: center;

  z-index: 999;
}

.modal {
  width: 100%;
  max-width: 520px;

  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 18px;

  padding: 24px;

  box-shadow:
    0 0 0 1px rgba(255, 255, 255, 0.02),
    0 30px 80px rgba(0, 0, 0, 0.45);

  animation: modalIn 0.18s ease;
}

@keyframes modalIn {
  from {
    opacity: 0;
    transform: translateY(8px) scale(0.98);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;

  margin-bottom: 20px;
}

.modal-title {
  font-family: 'Syne', sans-serif;
  font-size: 22px;
  font-weight: 700;
  color: var(--text-1);
}

.modal-close {
  width: 34px;
  height: 34px;

  border: 1px solid var(--border);
  background: transparent;

  border-radius: 10px;

  color: var(--text-2);

  cursor: pointer;
  transition: all 0.15s;
}

.modal-close:hover {
  background: rgba(255, 255, 255, 0.05);
  color: var(--text-1);
}

/* ─────────────────────────────
   FORM
───────────────────────────── */
.modal-form {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.field-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.field-label {
  font-size: 13px;
  font-weight: 500;
  color: var(--text-2);
}

.field-input {
  width: 100%;

  background: var(--surface-2);
  border: 1px solid var(--border);

  border-radius: 10px;

  padding: 12px 14px;

  color: var(--text-1);

  font-family: 'DM Sans', sans-serif;
  font-size: 14px;

  outline: none;

  transition: border-color 0.15s;
}

.field-input:focus {
  border-color: rgba(110, 231, 183, 0.4);
}

.field-textarea {
  resize: vertical;
  min-height: 110px;
}

/* ─────────────────────────────
   MODAL ACTIONS
───────────────────────────── */
.modal-actions {
  display: flex;
  justify-content: flex-end;
  gap: 10px;

  margin-top: 8px;
}

.btn-cancel,
.btn-confirm {
  padding: 10px 18px;

  border-radius: 10px;

  font-family: 'DM Sans', sans-serif;
  font-size: 13px;
  font-weight: 600;

  cursor: pointer;
  transition: all 0.15s;
}

.btn-cancel {
  background: transparent;
  border: 1px solid var(--border);
  color: var(--text-2);
}

.btn-cancel:hover {
  background: rgba(255, 255, 255, 0.05);
  color: var(--text-1);
}

.btn-confirm {
  border: 1px solid rgba(110, 231, 183, 0.25);
  background: var(--accent-dim);
  color: var(--accent);
}

.btn-confirm:hover {
  background: rgba(110, 231, 183, 0.18);
}

.btn-amber-confirm {
  background: var(--amber-dim);
  border-color: rgba(251, 191, 36, 0.25);
  color: var(--amber);
}

/* ─────────────────────────────
   ERRORS
───────────────────────────── */
.error-msg {
  font-size: 12px;
  color: var(--red);
}

.alert-error {
  display: flex;
  align-items: center;
  gap: 8px;

  padding: 12px 14px;

  border-radius: 10px;

  background: var(--red-dim);
  border: 1px solid rgba(248, 113, 113, 0.2);

  color: var(--red);

  font-size: 13px;
}

/* ─────────────────────────────
   SPINNER
───────────────────────────── */
.spinner {
  width: 14px;
  height: 14px;

  border-radius: 50%;
  border: 2px solid rgba(255, 255, 255, 0.2);
  border-top-color: currentColor;

  animation: spin 0.7s linear infinite;
}

.loader-ring {
  width: 42px;
  height: 42px;

  border-radius: 50%;
  border: 3px solid rgba(255, 255, 255, 0.08);
  border-top-color: var(--accent);

  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
</file>

<file path="src/app/features/solicitudes/detalle-solicitud/detalle-solicitud.html">
<div class="detalle-wrapper">
  <!-- Sidebar -->
  <aside class="sidebar">
    <div class="sidebar-logo">
      <span class="logo-hex">⬡</span>
      <span class="logo-text">SGS</span>
    </div>
    <nav class="sidebar-nav">
      <a class="nav-item" (click)="volver()">
        <span class="nav-icon">▦</span>
        <span>Solicitudes</span>
      </a>
    </nav>
    <div class="sidebar-footer">
      <div class="user-chip">
        <div class="user-avatar">{{ userInitial() }}</div>
        <div class="user-info">
          <span class="user-name">{{ userName() }}</span>
          <span class="user-role">{{ userRole() }}</span>
        </div>
      </div>
      <button class="btn-logout" (click)="logout()" title="Cerrar sesión">⏻</button>
    </div>
  </aside>

  <!-- Main -->
  <main class="main-content">
    <!-- Topbar -->
    <header class="topbar">
      <div class="topbar-left">
        <button class="btn-back" (click)="volver()">
          <span>←</span>
          <span>Volver</span>
        </button>
        <div class="breadcrumb">
          <span class="breadcrumb-parent" (click)="volver()">Solicitudes</span>
          <span class="breadcrumb-sep">/</span>
          @if (solicitud()) {
            <span class="breadcrumb-current">#{{ solicitud()!.id }}</span>
          }
        </div>
      </div>

      @if (solicitud()) {
        <div class="action-buttons">
          @if (puedeClasificar()) {
            <button class="btn-action btn-blue" (click)="abrirModalClasificar()">Clasificar</button>
          }
          @if (puedeAsignar()) {
            <button class="btn-action btn-blue" (click)="abrirModalAsignar()">
              Asignar responsable
            </button>
          }
          @if (puedeTomar()) {
            <button class="btn-action btn-blue" (click)="tomarSolicitud()">Tomar solicitud</button>
          }
          @if (puedeAtender()) {
            <button class="btn-action btn-amber" (click)="abrirModalAtender()">
              Marcar como atendida
            </button>
          }
          @if (puedeCerrar()) {
            <button class="btn-action btn-accent" (click)="abrirModalCerrar()">
              Cerrar solicitud
            </button>
          }
        </div>
      }
    </header>

    @if (loading()) {
      <div class="state-center">
        <div class="loader-ring"></div>
        <span>Cargando solicitud...</span>
      </div>
    }

    @if (error()) {
      <div class="state-center">
        <span class="state-icon">⚠</span>
        <span>{{ error() }}</span>
        <button class="btn-retry" (click)="volver()">Volver a la lista</button>
      </div>
    }

    @if (solicitud()) {
      <div class="detalle-content">
        <div class="solicitud-header">
          <div class="solicitud-header-left">
            <span class="solicitud-id">#{{ solicitud()!.id }}</span>
            <h1 class="solicitud-tipo">{{ formatTipo(solicitud()!.tipoSolicitud) }}</h1>
          </div>
          <div class="solicitud-header-right">
            <span class="badge-estado" [class]="'estado-' + solicitud()!.estado">
              {{ formatEstado(solicitud()!.estado) }}
            </span>
            @if (solicitud()!.prioridad) {
              <span class="badge-prioridad" [class]="'prio-' + solicitud()!.prioridad">
                {{ solicitud()!.prioridad }}
              </span>
            }
          </div>
        </div>

        <div class="info-grid">
          <div class="info-card info-card-full">
            <span class="info-label">Descripción</span>
            <p class="info-value info-desc">{{ solicitud()!.descripcion }}</p>
          </div>

          <div class="info-card">
            <span class="info-label">Solicitante</span>
            <div class="user-display">
              <div class="user-dot">
                {{ solicitud()!.solicitante!.nombre.charAt(0).toUpperCase() }}
              </div>
              <div>
                <p class="info-value">{{ solicitud()!.solicitante!.nombre }}</p>
                <p class="info-sub">{{ solicitud()!.solicitante!.correo }}</p>
              </div>
            </div>
          </div>

          <div class="info-card">
            <span class="info-label">Responsable</span>
            @if (solicitud()!.responsable) {
              <div class="user-display">
                <div class="user-dot user-dot-blue">
                  {{ solicitud()!.responsable!.nombre.charAt(0).toUpperCase() }}
                </div>
                <div>
                  <p class="info-value">{{ solicitud()!.responsable!.nombre }}</p>
                  <p class="info-sub">{{ solicitud()!.responsable!.correo }}</p>
                </div>
              </div>
            } @else {
              <p class="info-empty">Sin asignar</p>
            }
          </div>

          <div class="info-card">
            <span class="info-label">Fecha de creación</span>
            <p class="info-value">{{ solicitud()!.fecha | date: 'dd/MM/yyyy, h:mm a' }}</p>
          </div>

          <div class="info-card">
            <span class="info-label">Justificación de prioridad</span>
            @if (solicitud()!.justificacionPrioridad) {
              <p class="info-value">{{ solicitud()!.justificacionPrioridad }}</p>
            } @else {
              <p class="info-empty">Sin justificación asignada</p>
            }
          </div>
        </div>
        @if (historial().length > 0) {
          <div class="historial-section">
            <h3 class="historial-titulo">Historial</h3>
            <div class="historial-lista">
              @for (h of historial(); track h.id) {
                <div class="historial-item">
                  <div class="historial-dot"></div>
                  <div class="historial-info">
                    <p class="historial-accion">{{ h.accion }}</p>
                    <span class="historial-fecha">{{ h.fecha | date: 'dd/MM/yyyy, h:mm a' }}</span>
                  </div>
                </div>
              }
            </div>
          </div>
        }
      </div>
    }
  </main>
</div>

<!-- MODAL: CLASIFICAR -->
@if (modalClasificar()) {
  <div class="modal-backdrop" (click)="cerrarModalClasificar()">
    <div class="modal" (click)="$event.stopPropagation()">
      <div class="modal-header">
        <h2 class="modal-title">Clasificar solicitud</h2>
        <button class="modal-close" (click)="cerrarModalClasificar()">✕</button>
      </div>
      <form [formGroup]="clasificarForm" (ngSubmit)="clasificar()" class="modal-form">
        <!-- Botón IA va aquí, dentro del form -->
        <div class="ia-sugerencia">
          <button type="button" class="btn-ia" (click)="sugerirConIA()" [disabled]="loadingIA()">
            @if (loadingIA()) {
              <span class="spinner spinner-dark"></span> Analizando...
            } @else {
              ⬡ Sugerir con IA
            }
          </button>
          @if (errorIA()) {
            <span class="error-msg">{{ errorIA() }}</span>
          }
        </div>

        <div class="field-group">
          <label class="field-label">Prioridad</label>
          <select class="field-input" formControlName="prioridad">
            <option value="">Seleccionar...</option>
            <option value="ALTA">Alta</option>
            <option value="MEDIA">Media</option>
            <option value="BAJA">Baja</option>
          </select>
          @if (
            clasificarForm.get('prioridad')!.touched &&
            clasificarForm.get('prioridad')!.hasError('required')
          ) {
            <span class="error-msg">Selecciona una prioridad</span>
          }
        </div>
        <div class="field-group">
          <label class="field-label">Justificación</label>
          <textarea
            class="field-input field-textarea"
            formControlName="justificacion"
            placeholder="Explica el motivo de la clasificación..."
            rows="4"
          ></textarea>
          @if (
            clasificarForm.get('justificacion')!.touched &&
            clasificarForm.get('justificacion')!.hasError('required')
          ) {
            <span class="error-msg">La justificación es obligatoria</span>
          }
        </div>
        @if (errorClasificar()) {
          <div class="alert-error">
            <span>⚠</span><span>{{ errorClasificar() }}</span>
          </div>
        }
        <div class="modal-actions">
          <button type="button" class="btn-cancel" (click)="cerrarModalClasificar()">
            Cancelar
          </button>
          <button type="submit" class="btn-confirm" [disabled]="loadingClasificar()">
            @if (loadingClasificar()) {
              <span class="spinner"></span> Clasificando...
            } @else {
              Clasificar
            }
          </button>
        </div>
      </form>
    </div>
  </div>
}

<!-- MODAL: ASIGNAR RESPONSABLE -->
@if (modalAsignar()) {
  <div class="modal-backdrop" (click)="cerrarModalAsignar()">
    <div class="modal" (click)="$event.stopPropagation()">
      <div class="modal-header">
        <h2 class="modal-title">Asignar responsable</h2>
        <button class="modal-close" (click)="cerrarModalAsignar()">✕</button>
      </div>
      <div class="modal-form">
        @if (loadingResponsables()) {
          <div class="modal-loading">
            <div class="loader-ring"></div>
            <span>Cargando responsables...</span>
          </div>
        } @else {
          <div class="field-group">
            <label class="field-label">Responsable</label>
            <select class="field-input" (change)="seleccionarResponsable($event)">
              <option value="">Seleccionar...</option>
              @for (r of responsables(); track r.id) {
                <option [value]="r.id">
                  {{ r.nombre }} —
                  {{ r.role === 'ROL_ADMINISTRATIVO' ? 'Administrativo' : 'Docente' }}
                </option>
              }
            </select>
          </div>
        }
        @if (errorAsignar()) {
          <div class="alert-error">
            <span>⚠</span><span>{{ errorAsignar() }}</span>
          </div>
        }
        <div class="modal-actions">
          <button type="button" class="btn-cancel" (click)="cerrarModalAsignar()">Cancelar</button>
          <button
            class="btn-confirm"
            [disabled]="!responsableSeleccionado() || loadingAsignar()"
            (click)="asignarResponsable()"
          >
            @if (loadingAsignar()) {
              <span class="spinner"></span> Asignando...
            } @else {
              Asignar
            }
          </button>
        </div>
      </div>
    </div>
  </div>
}

<!-- MODAL: ATENDER -->
@if (modalAtender()) {
  <div class="modal-backdrop" (click)="cerrarModalAtender()">
    <div class="modal" (click)="$event.stopPropagation()">
      <div class="modal-header">
        <h2 class="modal-title">Marcar como atendida</h2>
        <button class="modal-close" (click)="cerrarModalAtender()">✕</button>
      </div>
      <form [formGroup]="atenderForm" (ngSubmit)="atender()" class="modal-form">
        <div class="field-group">
          <label class="field-label">Anotación</label>
          <textarea
            class="field-input field-textarea"
            formControlName="anotacion"
            placeholder="Describe cómo fue atendida la solicitud..."
            rows="4"
          ></textarea>
          @if (
            atenderForm.get('anotacion')!.touched &&
            atenderForm.get('anotacion')!.hasError('required')
          ) {
            <span class="error-msg">La anotación es obligatoria</span>
          }
        </div>
        @if (errorAtender()) {
          <div class="alert-error">
            <span>⚠</span><span>{{ errorAtender() }}</span>
          </div>
        }
        <div class="modal-actions">
          <button type="button" class="btn-cancel" (click)="cerrarModalAtender()">Cancelar</button>
          <button type="submit" class="btn-confirm btn-amber-confirm" [disabled]="loadingAtender()">
            @if (loadingAtender()) {
              <span class="spinner"></span> Guardando...
            } @else {
              Marcar como atendida
            }
          </button>
        </div>
      </form>
    </div>
  </div>
}

<!-- MODAL: CERRAR -->
@if (modalCerrar()) {
  <div class="modal-backdrop" (click)="cerrarModalCerrar()">
    <div class="modal" (click)="$event.stopPropagation()">
      <div class="modal-header">
        <h2 class="modal-title">Cerrar solicitud</h2>
        <button class="modal-close" (click)="cerrarModalCerrar()">✕</button>
      </div>
      <form [formGroup]="cerrarForm" (ngSubmit)="cerrar()" class="modal-form">
        <div class="field-group">
          <label class="field-label">Anotación de cierre</label>
          <textarea
            class="field-input field-textarea"
            formControlName="anotacion"
            placeholder="Describe el resultado final de la solicitud..."
            rows="4"
          ></textarea>
          @if (
            cerrarForm.get('anotacion')!.touched &&
            cerrarForm.get('anotacion')!.hasError('required')
          ) {
            <span class="error-msg">La anotación es obligatoria</span>
          }
        </div>
        @if (errorCerrar()) {
          <div class="alert-error">
            <span>⚠</span><span>{{ errorCerrar() }}</span>
          </div>
        }
        <div class="modal-actions">
          <button type="button" class="btn-cancel" (click)="cerrarModalCerrar()">Cancelar</button>
          <button type="submit" class="btn-confirm" [disabled]="loadingCerrar()">
            @if (loadingCerrar()) {
              <span class="spinner"></span> Cerrando...
            } @else {
              Cerrar solicitud
            }
          </button>
        </div>
      </form>
    </div>
  </div>
}
</file>

