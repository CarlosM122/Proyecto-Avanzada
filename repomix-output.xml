<div class="login-wrapper">
  <div class="login-backdrop">
    <div class="grid-lines"></div>
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
  </div>

  <div class="login-card">
    <div class="card-header">
      <div class="logo-mark">
        <span class="logo-icon">⬡</span>
      </div>
      <h1 class="brand">SGS</h1>
      <p class="brand-sub">Crear cuenta de estudiante</p>
    </div>

    <div class="divider-line"></div>

    <form [formGroup]="form" (ngSubmit)="onSubmit()" class="login-form">
      <div class="field-group">
        <label class="field-label" for="nombre">Nombre completo</label>
        <div class="input-wrapper">
          <span class="input-icon">◈</span>
          <input
            id="nombre"
            type="text"
            formControlName="nombre"
            class="field-input"
            placeholder="Tu nombre completo"
            [class.input-error]="nombre.touched && nombre.invalid"
          />
        </div>
        @if (nombre.touched && nombre.hasError('required')) {
          <span class="error-msg">El nombre es obligatorio</span>
        }
      </div>

      <div class="field-group">
        <label class="field-label" for="correo">Correo institucional</label>
        <div class="input-wrapper">
          <span class="input-icon">@</span>
          <input
            id="correo"
            type="email"
            formControlName="correo"
            class="field-input"
            placeholder="usuario@universidad.edu.co"
            [class.input-error]="correo.touched && correo.invalid"
          />
        </div>
        @if (correo.touched && correo.hasError('required')) {
          <span class="error-msg">El correo es obligatorio</span>
        }
        @if (correo.touched && correo.hasError('email')) {
          <span class="error-msg">Ingresa un correo válido</span>
        }
      </div>

      <div class="field-group">
        <label class="field-label" for="password">Contraseña</label>
        <div class="input-wrapper">
          <span class="input-icon">◈</span>
          <input
            id="password"
            type="password"
            formControlName="password"
            class="field-input"
            placeholder="••••••••"
            [class.input-error]="password.touched && password.invalid"
          />
        </div>
        @if (password.touched && password.hasError('required')) {
          <span class="error-msg">La contraseña es obligatoria</span>
        }
        @if (password.touched && password.hasError('minlength')) {
          <span class="error-msg">Mínimo 6 caracteres</span>
        }
      </div>

      <div class="field-group">
        <label class="field-label" for="semestre">Semestre</label>
        <div class="input-wrapper">
          <span class="input-icon">#</span>
          <input
            id="semestre"
            type="number"
            formControlName="semestre"
            class="field-input"
            placeholder="Ej: 4"
            min="1"
            max="10"
            [class.input-error]="semestre.touched && semestre.invalid"
          />
        </div>
        @if (semestre.touched && semestre.hasError('required')) {
          <span class="error-msg">El semestre es obligatorio</span>
        }
        @if (
          (semestre.touched && semestre.hasError('min')) ||
          (semestre.touched && semestre.hasError('max'))
        ) {
          <span class="error-msg">El semestre debe estar entre 1 y 10</span>
        }
      </div>

      <div class="field-group">
        <label class="field-label" for="telefono"
          >Teléfono <span class="optional">(opcional)</span></label
        >
        <div class="input-wrapper">
          <span class="input-icon">✆</span>
          <input
            id="telefono"
            type="tel"
            formControlName="telefono"
            class="field-input"
            placeholder="3001234567"
          />
        </div>
      </div>

      @if (errorMsg) {
        <div class="alert-error">
          <span class="alert-icon">!</span>
          <span>{{ errorMsg }}</span>
        </div>
      }

      <button type="submit" class="btn-submit" [disabled]="loading" [class.btn-loading]="loading">
        @if (loading) {
          <span class="spinner"></span>
          <span>Creando cuenta...</span>
        } @else {
          <span>Crear cuenta</span>
          <span class="btn-arrow">→</span>
        }
      </button>

      <p class="login-link">
        ¿Ya tienes cuenta?
        <a (click)="irLogin()">Inicia sesión</a>
      </p>
    </form>
  </div>
</div>
