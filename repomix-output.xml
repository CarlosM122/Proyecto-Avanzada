<div class="login-wrapper">
  <div class="login-backdrop">
    <div class="grid-lines"></div>
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
  </div>

  <div class="login-card">
    <div class="card-header">
      <div class="logo-mark">
        <span class="logo-icon">⬡</span>
      </div>
      <h1 class="brand">SGS</h1>
      <p class="brand-sub">Sistema de Gestión de Solicitudes</p>
    </div>

    <div class="divider-line"></div>

    <form [formGroup]="form" (ngSubmit)="onSubmit()" class="login-form">
      <div class="field-group">
        <label class="field-label" for="correo">Correo institucional</label>
        <div class="input-wrapper">
          <span class="input-icon">@</span>
          <input
            id="correo"
            type="email"
            formControlName="correo"
            class="field-input"
            placeholder="usuario@universidad.edu.co"
            [class.input-error]="correo.touched && correo.invalid"
          />
        </div>
        @if (correo.touched && correo.hasError('required')) {
          <span class="error-msg">El correo es obligatorio</span>
        }
        @if (correo.touched && correo.hasError('email')) {
          <span class="error-msg">Ingresa un correo válido</span>
        }
      </div>

      <div class="field-group">
        <label class="field-label" for="password">Contraseña</label>
        <div class="input-wrapper">
          <span class="input-icon">◈</span>
          <input
            id="password"
            type="password"
            formControlName="password"
            class="field-input"
            placeholder="••••••••"
            [class.input-error]="password.touched && password.invalid"
          />
        </div>
        @if (password.touched && password.hasError('required')) {
          <span class="error-msg">La contraseña es obligatoria</span>
        }
        @if (password.touched && password.hasError('minlength')) {
          <span class="error-msg">Mínimo 6 caracteres</span>
        }
      </div>

      @if (errorMsg) {
        <div class="alert-error">
          <span class="alert-icon">!</span>
          <span>{{ errorMsg }}</span>
        </div>
      }

      <button type="submit" class="btn-submit" [disabled]="loading" [class.btn-loading]="loading">
        @if (loading) {
          <span class="spinner"></span>
          <span>Verificando...</span>
